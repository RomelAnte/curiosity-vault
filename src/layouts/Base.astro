---
const { title = 'Curiosity Vault' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Una biblioteca abierta de guías, ideas y colecciones." />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a class="brand" href={base}>Curiosity Vault</a>
      <nav aria-label="Navegación principal">
        <a href={`${base}guias/`}>Guías</a>
        <a href={`${base}libros/`}>Libros</a>
        <a href={`${base}peliculas/`}>Películas</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>Conocimiento en construcción · <a href={`${base}LICENSE.md`}>CC BY 4.0</a></footer>
  </body>
</html>

<style is:global>
  :root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #17221b; background: #f7f5ee; }
  * { box-sizing: border-box; }
  body { margin: 0; line-height: 1.65; }
  header, main, footer { max-width: 1120px; margin: auto; padding-inline: 1.25rem; }
  header { min-height: 5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .brand { font-weight: 800; font-size: 1.15rem; text-decoration: none; color: #193a2a; }
  nav { display: flex; gap: 1rem; flex-wrap: wrap; }
  a { color: #0b6242; } nav a { text-decoration: none; }
  main { padding-block: 3.5rem 5rem; } footer { border-top: 1px solid #d8ddd3; padding-block: 1.5rem; color: #526057; font-size: .9rem; }
  h1 { font-size: clamp(2.3rem, 7vw, 5rem); line-height: 1; letter-spacing: -.06em; max-width: 14ch; }
  h2 { margin-top: 2.4rem; } .lede { max-width: 60ch; font-size: 1.2rem; color: #405046; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1rem; margin-top: 2rem; }
  .card { display: block; background: #fffef9; border: 1px solid #d8ddd3; border-radius: 1rem; padding: 1.25rem; text-decoration: none; color: inherit; transition: transform .15s; }
  .card:hover { transform: translateY(-3px); border-color: #79a98e; } .card span { color: #5b6d60; font-size: .9rem; }
  article { max-width: 760px; } article h1 { max-width: none; font-size: clamp(2.3rem, 6vw, 4.2rem); } article h2 { border-top: 1px solid #d8ddd3; padding-top: 1.5rem; } article blockquote { border-left: 3px solid #74a68b; margin-left: 0; padding-left: 1rem; color: #405046; }
</style>
