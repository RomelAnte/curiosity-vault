---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('contenido');
  return entries
    .filter((entry) => entry.id.startsWith('guias/') || entry.id.startsWith('colecciones/'))
    .map((entry) => ({ params: { slug: entry.id.split('/').at(-1) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={`${entry.id.split('/').at(-1).replaceAll('-', ' ')} · Curiosity Vault`}>
  <article><Content /></article>
</Base>
