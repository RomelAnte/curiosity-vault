---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('contenido');
  return entries
    .filter((entry) => entry.id.startsWith('guias/'))
    .map((entry) => ({ params: { slug: entry.id.replace('guias/', '') }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = entry.id.replace('guias/', '').replaceAll('-', ' ');
---
<Base title={`${title} · Curiosity Vault`}>
  <article><Content /></article>
</Base>
