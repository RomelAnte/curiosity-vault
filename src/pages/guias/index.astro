---
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import TagFilter from "../../components/TagFilter.astro";
import { getCollection } from "astro:content";

const guias = (await getCollection("contenido")).filter((entry) =>
  entry.id.startsWith("guias/"),
);
const categories = [...new Set(guias.map((g) => g.data.category))];
const base = import.meta.env.BASE_URL;
---

<Base title="Todas las Guías · Curiosity Vault">
  <div class="header-block">
    <h1 class="page-title">Guías</h1>
    <p class="page-subtitle">
      Guías basadas en apuntes personales, editadas para dar contexto y proponer formas concretas de explorar cada tema.
    </p>
  </div>

  <TagFilter categories={categories} />

  <div class="grid-container" id="guias-grid">
    {
      guias.map((entry) => {
        const slug = entry.id.replace("guias/", "");
        return (
          <div data-card-category={entry.data.category} style="display: flex;">
            <Card
              href={`${base}/${slug}/`}
              title={entry.data.title}
              description={entry.data.description}
              category={entry.data.category}
              tags={entry.data.tags}
              icon={entry.data.icon}
              wordCount={entry.body ? entry.body.split(/\s+/).length : 400}
              featured={entry.data.featured}
            />
          </div>
        );
      })
    }
  </div>
</Base>

<style>
  .header-block {
    margin-bottom: 1rem;
  }
</style>
