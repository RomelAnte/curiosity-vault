---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("contenido");
const guias = entries.filter((entry) => entry.id.startsWith("guias/"));
const featuredGuias = guias.filter((entry) => entry.data.featured);
const base = import.meta.env.BASE_URL;

const categories = [...new Set(guias.map((g) => g.data.category))];
---

<Base title="Curiosity Vault · De curiosidad a conocimiento práctico">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-badge">
      <span class="pulse-dot"></span>
      Biblioteca ABIERTA A LA COMUNIDAD
    </div>

    <h1 class="hero-title">
      Ideas que se convierten en <span class="gradient-text">práctica real.</span>
    </h1>

    <p class="hero-lede">
      Guías y colecciones construidas a partir de apuntes personales, con edición transparente y contexto para aprender sobre empleabilidad, idiomas, negocios, tecnología y desarrollo.
    </p>

    <div class="hero-actions">
      <a href={`${base}/guias/`} class="btn-primary">
        Explorar todas las guías
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a href={`${base}/colecciones/`} class="btn-secondary">
        Ver colecciones
      </a>
    </div>

    <!-- Quick Stats -->
    <div class="stats-row">
      <div class="stat-item">
        <span class="stat-num">{guias.length}</span>
        <span class="stat-label">Guías abiertas</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-num">{categories.length}</span>
        <span class="stat-label">Categorías de aprendizaje</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-num">CC BY 4.0</span>
        <span class="stat-label">Licencia abierta</span>
      </div>
    </div>
  </section>

  <!-- Featured Guides -->
  <section class="section-container">
    <div class="section-header">
      <div>
        <h2 class="section-title">Guías Destacadas</h2>
        <p class="section-subtitle">Ideas organizadas para poner en práctica</p>
      </div>
      <a href={`${base}/guias/`} class="view-all-link">Ver todas ({guias.length}) →</a>
    </div>

    <div class="grid-container">
      {
        featuredGuias.map((entry) => {
          const slug = entry.id.replace("guias/", "");
          return (
            <Card
              href={`${base}/${slug}/`}
              title={entry.data.title}
              description={entry.data.description}
              category={entry.data.category}
              tags={entry.data.tags}
              icon={entry.data.icon}
              wordCount={entry.body ? entry.body.split(/\s+/).length : 400}
              featured={entry.data.featured}
            />
          );
        })
      }
    </div>
  </section>

  <!-- Categories Showcase -->
  <section class="section-container">
    <div class="section-header">
      <h2 class="section-title">Explora por Categorías</h2>
    </div>

    <div class="categories-grid">
      {
        categories.map((cat) => {
          const count = guias.filter((g) => g.data.category === cat).length;
          return (
            <a href={`${base}/guias/?cat=${encodeURIComponent(cat)}`} class="category-card">
              <span class="category-name">{cat}</span>
              <span class="category-count">{count} {count === 1 ? 'guía' : 'guías'}</span>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- Contribution CTA Banner -->
  <section class="contribution-banner">
    <div class="banner-content">
      <span class="banner-icon">🤝</span>
      <div>
        <h3>Tu experiencia también puede ayudar</h3>
        <p>¿Probaste una técnica o conoces una fuente útil? Propón una guía o ayuda a mejorar el contenido de forma abierta en GitHub.</p>
      </div>
    </div>
    <a href="https://github.com/RomelAnte/curiosity-vault/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer" class="btn-primary glow">
      Aprende a contribuir
    </a>
  </section>
</Base>

<style>
  .hero-section {
    padding-block: 2rem 4rem;
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: 2rem;
    background: var(--badge-bg);
    color: var(--badge-text);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }
  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-emerald);
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: pulse 1.8s infinite;
  }
  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }
  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--color-emerald-light), var(--color-teal));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-lede {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 2.25rem;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-emerald);
    color: #ffffff;
    padding: 0.85rem 1.6rem;
    border-radius: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.25);
  }
  .btn-primary:hover {
    background: var(--color-emerald-light);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(16, 185, 129, 0.35);
  }
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 0.85rem 1.6rem;
    border-radius: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-secondary:hover {
    background: var(--bg-hover);
    border-color: var(--color-emerald-light);
    transform: translateY(-2px);
  }
  .stats-row {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 1rem 2rem;
    border-radius: 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .stat-num {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
  }
  .stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .stat-divider {
    width: 1px;
    height: 28px;
    background: var(--border-color);
  }
  .section-container {
    margin-top: 4.5rem;
  }
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 1.75rem;
  }
  .section-title {
    font-size: 1.75rem;
    letter-spacing: -0.02em;
  }
  .section-subtitle {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-top: 0.25rem;
  }
  .view-all-link {
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }
  .category-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    padding: 1.25rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    transition: all 0.2s ease;
  }
  .category-card:hover {
    border-color: var(--color-emerald-light);
    transform: translateY(-2px);
    background: var(--bg-hover);
  }
  .category-name {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--text-primary);
    font-size: 1rem;
  }
  .category-count {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .contribution-banner {
    margin-top: 5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 1.25rem;
    padding: 2.25rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    box-shadow: 0 10px 30px -10px var(--shadow-color);
  }
  .banner-content {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .banner-icon {
    font-size: 2.75rem;
  }
  .banner-content h3 {
    font-size: 1.25rem;
    margin-bottom: 0.35rem;
  }
  .banner-content p {
    color: var(--text-muted);
    font-size: 0.925rem;
    max-width: 55ch;
  }

  @media (max-width: 768px) {
    .stats-row {
      flex-direction: column;
      gap: 1rem;
      width: 100%;
    }
    .stat-divider {
      display: none;
    }
    .contribution-banner {
      flex-direction: column;
      text-align: center;
      padding: 1.75rem;
    }
    .banner-content {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>

