---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const entries = await getCollection('contenido');
const guias = entries.filter((entry) => entry.id.startsWith('guias/'));
---
<Base>
  <p>Biblioteca abierta</p>
  <h1>Ideas que se convierten en práctica.</h1>
  <p class="lede">Guías creadas desde apuntes personales, con edición transparente, investigación cuando aporta valor y espacio para seguir aprendiendo.</p>
  <h2>Explora las guías</h2>
  <section class="grid">
    {guias.map((entry) => <a class="card" href={`/guias/${entry.id.replace('guias/', '')}`}><strong>{entry.id.replace('guias/', '').replaceAll('-', ' ')}</strong><br /><span>Guía comunitaria</span></a>)}
  </section>
</Base>
